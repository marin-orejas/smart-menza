{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:smartmenzaserver.database.windows.net;Authentication=Active Directory Default;Database=SmartMenzaDB;"
  },
  "JwtSettings": {
    "SecretKey": "replace-with-a-random-key-of-at-least-32-characters",
    "ExpirationDays": 7
  },
  "AzureStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=smartmenzastorage;AccountKey=...;EndpointSuffix=core.windows.net",
    "ContainerName": "dish-image"
  },
  "AzureOpenAI": {
    "Endpoint": "<your-azure-openai-endpoint>",
    "ApiKey": "<your-azure-openai-key>",
    "ChatDeployment": "food-chat"
  }
}
